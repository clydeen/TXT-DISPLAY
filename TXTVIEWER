local UIGradient = Instance.new("UIGradient")
UIGradient.Color = ColorSequence.new({
	ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 0, 0)),
	ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
	ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
	ColorSequenceKeypoint.new(0.50, Color3.fromRGB(0, 255, 255)),
	ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0, 0, 255)),
	ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
	ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 255, 255)),
})
UIGradient.Parent = colorGradientBar

local isSelectingColor = false
colorGradientBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		isSelectingColor = true
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		isSelectingColor = false
	end
end)

local function updateColor(input)
	local mousePos = input.Position.X
	local barPos = colorGradientBar.AbsolutePosition.X
	local barWidth = colorGradientBar.AbsoluteSize.X
	local alpha = math.clamp((mousePos - barPos) / barWidth, 0, 1)

	if alpha >= 0.95 then
		mainFrame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	else
		mainFrame.BackgroundColor3 = Color3.fromHSV(alpha / 0.95, 0.6, 1)
	end
end

colorGradientBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		updateColor(input)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if isSelectingColor and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		updateColor(input)
	end
end)

